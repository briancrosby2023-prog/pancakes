{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operation-pancake.local/schemas/sop_decision.schema.json",
  "title": "Operation Pancake consequential decision record",
  "type": "object",
  "required": [
    "decision_id",
    "mission",
    "request",
    "map_evidence",
    "history_evidence",
    "research_evidence",
    "capability_evidence",
    "proposed_plan",
    "allowed_actions",
    "blocked_actions",
    "decision_status",
    "next_action",
    "provider_called"
  ],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "mission": {"type": "string", "minLength": 1},
    "request": {"type": "string", "minLength": 1},
    "map_evidence": {"type": "array", "items": {"type": "string"}},
    "history_evidence": {"type": "array", "items": {"type": "string"}},
    "research_evidence": {"type": "array", "items": {"type": "string"}},
    "capability_evidence": {"type": "array", "items": {"type": "string"}},
    "proposed_plan": {"type": "string"},
    "allowed_actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "blocked_actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "decision_status": {
      "enum": [
        "PREFLIGHT_REQUIRED",
        "PREFLIGHT_PASS",
        "DECISION_ALLOWED",
        "ACTION_ALLOWED",
        "BLOCKED_EXTERNAL",
        "COMPLETE"
      ]
    },
    "next_action": {"type": "string"},
    "missing_requirements": {"type": "array", "items": {"type": "string"}},
    "gate_errors": {"type": "array", "items": {"type": "string"}},
    "state_fingerprint": {"type": ["string", "null"]},
    "provider_called": {"type": "boolean"}
  },
  "additionalProperties": false
}
