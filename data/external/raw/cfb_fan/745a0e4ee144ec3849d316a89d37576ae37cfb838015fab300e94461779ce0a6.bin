        return Math.random() < ALLOCATION_PERCENT / 100 ? STORMSTRIKE : RAPTIVE;
    }

    function fallBackToRaptive(reason) {
        decision.reason = reason;
        decision.stack = RAPTIVE;
        w.__loadRaptiveAds();
